# Copy to .env and edit. Everything works without any key (offline GenAI engine).

# --- Database (default: SQLite file backend/factoryguard.db) ---
# DATABASE_URL=postgresql+psycopg2://factoryguard:factoryguard@localhost:5432/factoryguard
# DATABASE_URL=mysql+pymysql://factoryguard:factoryguard@localhost:3306/factoryguard

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
ACCESS_TOKEN_MINUTES=480

# --- GenAI provider: gemini | groq | openai | offline (auto-detected from the key you set) ---
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini

# --- Real-time sensor simulator ---
SIMULATOR_AUTOSTART=true
SIMULATOR_INTERVAL_SEC=10

PLANT_TZ=Asia/Kolkata
